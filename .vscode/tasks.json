{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure Chess",
      "type": "process",
      "command": "cmake",
      "args": [
        "-S", "${workspaceFolder}",
        "-B", "${workspaceFolder}/build",
        "-G", "MinGW Makefiles",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_CXX_COMPILER=C:/msys64/ucrt64/bin/g++.exe",
        "-DCMAKE_PREFIX_PATH=C:/msys64/ucrt64"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Build Chess",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build", "${workspaceFolder}/build",
        "--parallel", "4"
      ],
      "dependsOn": "Configure Chess",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
        }
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}