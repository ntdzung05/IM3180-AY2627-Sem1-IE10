{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Chess",
      "type": "process",
      "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
      "args": [
        "-std=c++17",
        "-g",
        "${workspaceFolder}/main.cpp",
        "${workspaceFolder}/board.cpp",
        "${workspaceFolder}/UI files/ui.cpp",
        "-o",
        "${workspaceFolder}/chess.exe",
        "-lsfml-graphics",
        "-lsfml-window",
        "-lsfml-audio",
        "-lsfml-system"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}